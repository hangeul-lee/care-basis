NODE_ENV=production
DB_MODE=mysql
DB_AUTO_MIGRATE=true
DB_HOST=your-aiven-mysql-host
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=defaultdb
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_B64=base64-encoded-aiven-ca-certificate
APP_PIN=change-this-family-pin
AUTH_SECRET=change-this-long-random-secret
